# Sample.env — example environment variables for running Allstar locally
# Copy to .env or export these in your shell before running `go run ./cmd/allstar` or the built binary.
#
# Notes:
# - `APP_ID` and `PRIVATE_KEY` are required to authenticate as a GitHub App.
# - To keep the private key in this file set `KEY_SECRET=direct` and put the PEM in `PRIVATE_KEY`.
#   Alternatively set `KEY_SECRET` to a runtimevar URL (e.g. gcpsecretmanager://...) and omit `PRIVATE_KEY`.

# GitHub App settings
APP_ID=REPLACE_WITH_YOUR_APP_ID
# If you set KEY_SECRET=direct, paste the PEM here with literal `\n` for newlines, or set KEY_SECRET to a secret manager URL.
KEY_SECRET=direct
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_OR_PEM_CONTENT\n-----END PRIVATE KEY-----"

# Optional: GitHub Enterprise API base URL (leave empty for github.com)
ALLSTAR_GHE_URL=

# Behavior flags
DO_NOTHING_ON_OPT_OUT=true
ALLSTAR_LOG_LEVEL=DEBUG

# How often to ping notice actions (hours). Default used if empty.
NOTICE_PING_DURATION_HOURS=168

# Comma-separated list of allowed organizations (empty = all)
GITHUB_ALLOWED_ORGS=GSA-TTS

# Number of concurrent installation workers for local testing (default 5 in prod)
ALLSTAR_NUM_WORKERS=1
